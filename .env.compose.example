# 网关的 Chat Completions 端点，可按部署环境覆盖。
UPSTREAM_URL=https://open-sealion.aiaigirl.com/v1/chat/completions
# 部署时用 deploy/compose/init-env.sh 在 .env 中生成 Redis 和 MySQL 应用密码。
REDIS_PASSWORD=
RELAY_BIND_HOST=127.0.0.1
RELAY_PORT=8000
# 请求和响应各预览最多 2048 个原始字节，设为 false 可关闭正文日志。
RELAY_LOG_CONTENT=true
# 旧版 Ollama 卷已有权重时设为 replay。Rust 直接在 CPU 上读取卷内的 GGUF。
HISTORY_EMBEDDING_MODE=off
HISTORY_EMBEDDING_MODEL=embeddinggemma:300m-qat-q8_0
# 可选，容器内的独立 GGUF。留空时按固定 SHA-256 读取模型目录下的 blobs/sha256-<摘要>，并校验整份文件。
HISTORY_EMBEDDING_MODEL_PATH=
# 复用已有模型卷时填入 Docker 卷名，并把 MODEL_VOLUME_EXTERNAL 改为 true。
MODEL_VOLUME_NAME=
MODEL_VOLUME_EXTERNAL=false
HISTORY_EMBEDDING_LAST_RESORT_THRESHOLD=

# 主配置自带 MySQL。官方镜像在空数据卷初始化时生成管理员密码。
MYSQL_HOST=mysql
MYSQL_DATABASE=recall_relay
MYSQL_USER=recall_relay
MYSQL_PASSWORD=
