# 网关的 Chat Completions 端点，可按部署环境覆盖。
UPSTREAM_URL=https://open-sealion.aiaigirl.com/v1/chat/completions
# 用 openssl rand -hex 32 生成，避免密码中的 URL 保留字符影响 Redis 连接。
REDIS_PASSWORD=
RELAY_BIND_HOST=127.0.0.1
RELAY_PORT=8000
# 默认使用 gemma4-31b-heretic。取消下一行的注释并留空可关闭网关备用模型。
# FALLBACK_MODEL=
HISTORY_EMBEDDING_MODE=off
HISTORY_EMBEDDING_LAST_RESORT_THRESHOLD=
CPU_FALLBACK_ENABLED=true

# 启用 MySQL 长期历史时填写。Compose 的 mysql.yaml 会设置内部服务地址。
MYSQL_HOST=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
